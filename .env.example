# Copy this file to .env and fill in your own values.
# .env is gitignored - never commit real tokens.

# From @BotFather on Telegram (required)
TELEGRAM_BOT_TOKEN=123456789:AAaaAAaaAAaaAAaaAAaaAAaaAAaaAAaaAAa

# Your group's id (required). Run `python bot.py chat-id` to find it.
# Supergroups look like -1001234567890.
TELEGRAM_CHAT_ID=-1001234567890

# Optional: post into one topic of a forum-style group.
# TELEGRAM_THREAD_ID=

# How often to send. Accepts 90s, 15m, 2h, 1d, or a plain number of seconds.
INTERVAL=1h

# Where the messages live. Separate messages with a line containing only ---
MESSAGES_FILE=messages.txt

# Or skip the file entirely and send one fixed message (\n makes a new line):
# MESSAGE=Hello from the bot!

# sequential = cycle through messages in order; random = pick at random
ROTATION=sequential

# HTML, Markdown, MarkdownV2, or none
PARSE_MODE=HTML

# true = deliver without a notification sound
SILENT=false

# true = send one message immediately on startup instead of waiting a full interval
SEND_ON_START=true
