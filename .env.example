# Copy this file to .env and fill in your own values.
# .env is gitignored - never commit real tokens.

# Get these from https://my.telegram.org/apps (required)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# Your phone number with country code (optional - will prompt if not set)
TELEGRAM_PHONE=+911234567890

# Session file name (saved after first login so you don't need to re-authenticate)
SESSION_NAME=user_session

# Group id(s) to post to (required). Comma-separated for multiple groups.
# Run `python bot.py groups` to list all your groups and their ids.
TELEGRAM_CHAT_ID=-1001234567890,-1009876543210

# How often to send. Accepts 90s, 15m, 2h, 1d, or a plain number of seconds.
INTERVAL=1h

# Where the messages live. Separate messages with a line containing only ---
MESSAGES_FILE=messages.txt

# Or skip the file entirely and send one fixed message (\n makes a new line):
# MESSAGE=Hello from the bot!

# sequential = cycle through messages in order; random = pick at random
ROTATION=sequential

# true = send one message immediately on startup instead of waiting a full interval
SEND_ON_START=true
